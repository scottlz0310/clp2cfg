{
  "name": "clp2cfg",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight GUI tool to parse and merge MCP server config snippets into AI client configurations",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "lefthook": "^2.2.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
